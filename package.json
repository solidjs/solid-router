{
  "name": "@solidjs/router",
  "description": "Universal router for SolidJS",
  "author": "Ryan Carniato",
  "contributors": [
    "Ryan Turnquist"
  ],
  "license": "MIT",
  "version": "2.0.0-next.20",
  "homepage": "https://github.com/solidjs/solid-router#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/solidjs/solid-router"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "solid": "./dist/index.jsx",
      "default": "./dist/index.js"
    },
    "./server": "./dist/server.js",
    "./fs": "./dist/fs.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc && rollup -c",
    "prepublishOnly": "npm run build",
    "test": "vitest run && vitest run --config vitest.config.server.ts && npm run test:types",
    "test:watch": "vitest",
    "test:server": "vitest run --config vitest.config.server.ts",
    "test:types": "tsc --project tsconfig.test.json",
    "pretty": "prettier --write \"{src,test}/**/*.{ts,tsx}\"",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@changesets/cli": "^2.27.10",
    "@rollup/plugin-babel": "6.0.4",
    "@rollup/plugin-node-resolve": "15.3.0",
    "@rollup/plugin-terser": "0.4.4",
    "@solidjs/vite-plugin": "3.0.0-next.35",
    "@solidjs/web": "^2.0.0-rc.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "babel-preset-solid": "^2.0.0-rc.2",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.1",
    "rollup": "^4.27.4",
    "solid-js": "^2.0.0-rc.5",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.5",
    "solid-js": "^2.0.0-rc.5"
  },
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8"
}
